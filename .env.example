NODE_ENV=development
PORT=8080

# Comma-separated browser origins. Use * only for local testing.
FRONTEND_ORIGINS=http://localhost:3000

# Backend-authoritative upload limit.
MAX_UPLOAD_SIZE_MB=500

# Zero-budget CPU default: run one processing job at a time.
MAX_CONCURRENT_JOBS=1

# Completed/failed job files older than this are automatically removed.
JOB_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=30

# Relative path is resolved from the project working directory.
TEMP_DIR=./storage/jobs

# Real CPU-only Python engine is now included in ai_studio_code.py.
PYTHON_ENGINE_ENABLED=true

# Windows local development: normally use "python".
# Railway Docker image overrides this to /opt/venv/bin/python.
PYTHON_EXECUTABLE=python
PYTHON_ENGINE_PATH=./ai_studio_code.py
PYTHON_ENGINE_TIMEOUT_MS=86400000
