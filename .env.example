NODE_ENV=development
PORT=8080

# Comma-separated browser origins. Use * only for local testing; explicit origins are recommended in production.
FRONTEND_ORIGINS=http://localhost:3000

# Backend-authoritative upload limit.
MAX_UPLOAD_SIZE_MB=500

# Number of in-process jobs allowed to execute at once. Keep 1 for zero-budget CPU-only deployments.
MAX_CONCURRENT_JOBS=1

# Completed/failed job files older than this are automatically removed.
JOB_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=30

# Root directory for per-job files. Relative paths are resolved from this project directory.
TEMP_DIR=./storage/jobs

# Future Python engine integration.
# Leave false until your ai_studio_code.py is supplied and its adapter contract is confirmed.
PYTHON_ENGINE_ENABLED=false
PYTHON_EXECUTABLE=python
PYTHON_ENGINE_PATH=
PYTHON_ENGINE_TIMEOUT_MS=86400000

# Generic Python engine CLI contract used by the adapter once enabled:
# python <PYTHON_ENGINE_PATH> --input <input> --output <output> --scale <scale> --quality <quality> --job-id <jobId>
